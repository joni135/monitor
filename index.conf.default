{
    "maininfos": {
        "siteauthor": "Jonathan Kaufmann",
        "sitetitleprefix": "Monitorshow - ",
        "system": {
            "publicfolder": "./public/",
            "monitorsfolder": "./monitors/"
        },
        "monitorconfigfile": "config.json",
        "proxy": {
            "allowedTargets": {
                "localhost": "http://localhost:8080"
            }
        }
    },
    "plugins": {
        "weatherandhydrodata": {
            "processpath": "./backend/weathercalculator/",
            "datapath": "./backend/weathercalculator/data/",
            "symbolpath": "./backend/weathercalculator/data/weather_svgs/"
        },
        "calendar": {
            "processpath": "./backend/calendar/",
            "datapath": "./backend/calendar/data/",
            "symbolpath": "./backend/calendar/data/symbols/"
        }
    },

    "monitors": [
        {
            "id": "example",
            "name": "Example Monitor",
            "available": true,
            "htmlfile": "example.html",
            "datapath": "./example/",
            "favicon": "./example.png",
            "plugins": ["infocarousel", "slideshow", "weatherandhydrodata", "calendar"]
        }
    ]
}